<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <application>
        <activity
            android:name=".CapturePermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="${applicationId}.screenCapture"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service
            android:name=".FloatingWindowService"
            android:exported="false"
            android:foregroundServiceType="specialUse|mediaProjection">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-controlled floating Xiangqi analysis panel; screen sharing is retained while modes are paused and ends when the user presses Stop or closes the window." />
        </service>
    </application>
</manifest>
